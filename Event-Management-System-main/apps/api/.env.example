NODE_ENV=development
PORT=5000

# Neon: use the pooled URL for the running API. Use a direct URL for migrations when available.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-64-character-random-secret
TICKET_TOKEN_SECRET=replace-with-a-different-64-character-random-secret
INTERNAL_JOB_TOKEN=replace-with-a-third-64-character-random-secret

WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:5000
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:3000/checkout/cancelled
ORDER_HOLD_MINUTES=15

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=re_replace_me
EMAIL_FROM=EventFlow <onboarding@example.com>
EMAIL_REPLY_TO=

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Required only for the initial admin seed command.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-local-password

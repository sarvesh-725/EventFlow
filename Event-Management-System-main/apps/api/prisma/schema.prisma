generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

enum OrganizerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ModerationStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOID
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CLAIMED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  name              String
  role              UserRole         @default(USER)
  organizerStatus   OrganizerStatus?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  ownedEvents       Event[]          @relation("EventOwner")
  staffAssignments  EventStaff[]
  orders            Order[]
  tickets           Ticket[]         @relation("TicketAttendee")
  checkIns          CheckIn[]        @relation("CheckInStaff")
  auditLogs         AuditLog[]       @relation("AuditActor")
  waitlistEntries   WaitlistEntry[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model Event {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation("EventOwner", fields: [ownerId], references: [id])
  title            String
  slug             String           @unique
  description      String
  venue            String
  startsAt         DateTime
  endsAt           DateTime?
  timezone         String           @default("UTC")
  status           EventStatus      @default(DRAFT)
  moderationStatus ModerationStatus @default(VISIBLE)
  coverImageUrl    String?
  profileImageUrl  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ticketTypes      TicketType[]
  staff            EventStaff[]
  orders           Order[]
  tickets          Ticket[]
  checkIns         CheckIn[]
  waitlistEntries  WaitlistEntry[]
  auditLogs        AuditLog[]

  @@index([ownerId, status])
  @@index([status, startsAt])
  @@index([moderationStatus, startsAt])
}

model EventStaff {
  eventId     String
  userId      String
  permissions String[] @default([])
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model TicketType {
  id              String           @id @default(cuid())
  eventId         String
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  priceMinor      Int
  currency        String           @default("INR")
  capacity        Int
  reservedQuantity Int              @default(0)
  soldQuantity    Int              @default(0)
  maxPerOrder     Int              @default(10)
  status          TicketTypeStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItems      OrderItem[]
  waitlistEntries WaitlistEntry[]

  @@index([eventId, status])
}

model Order {
  id                      String      @id @default(cuid())
  purchaserId             String
  eventId                 String
  purchaser               User        @relation(fields: [purchaserId], references: [id])
  event                   Event       @relation(fields: [eventId], references: [id])
  status                  OrderStatus @default(PENDING)
  currency                String      @default("INR")
  totalMinor              Int
  holdExpiresAt           DateTime?
  stripeCheckoutSessionId String?     @unique
  stripeCheckoutUrl       String?
  idempotencyKey          String      @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  items                   OrderItem[]
  payment                 Payment?
  tickets                 Ticket[]

  @@index([purchaserId, createdAt])
  @@index([eventId, status])
  @@index([status, holdExpiresAt])
}

model OrderItem {
  id            String     @id @default(cuid())
  orderId       String
  ticketTypeId  String
  quantity      Int
  unitPriceMinor Int
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets       Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String        @unique
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            String        @default("stripe")
  providerPaymentId   String?       @unique
  checkoutSessionId   String?       @unique
  status              PaymentStatus @default(PENDING)
  amountMinor         Int
  currency            String
  failureCode         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Ticket {
  id             String       @id @default(cuid())
  orderId        String
  orderItemId    String
  eventId        String
  attendeeUserId String?
  publicCodeHash String       @unique
  publicCodeEncrypted String
  publicCodeLast4 String
  attendeeName   String?
  attendeeEmail  String?
  status         TicketStatus @default(ISSUED)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id])
  attendee       User?        @relation("TicketAttendee", fields: [attendeeUserId], references: [id])
  checkIn        CheckIn?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([eventId, status])
  @@index([attendeeUserId])
}

model CheckIn {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  eventId     String
  staffId     String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])
  staff       User     @relation("CheckInStaff", fields: [staffId], references: [id])
  checkedInAt DateTime @default(now())

  @@index([eventId, checkedInAt])
}

model WaitlistEntry {
  id           String         @id @default(cuid())
  eventId      String
  ticketTypeId String?
  userId       String
  status       WaitlistStatus @default(WAITING)
  offeredUntil DateTime?
  claimedAt    DateTime?
  createdAt    DateTime       @default(now())
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType?    @relation(fields: [ticketTypeId], references: [id])
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, ticketTypeId, status, createdAt])
  @@index([userId])
}

model OutboxJob {
  id             String    @id @default(cuid())
  kind           String
  dedupeKey      String    @unique
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt])
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  eventId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  event      Event?   @relation(fields: [eventId], references: [id])
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([eventId, createdAt])
  @@index([entityType, entityId])
}

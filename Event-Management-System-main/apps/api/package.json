{
  "name": "@eventflow/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "node ../../scripts/prisma-cli.mjs generate",
    "db:validate": "node ../../scripts/prisma-cli.mjs validate",
    "db:migrate": "node ../../scripts/prisma-cli.mjs migrate dev",
    "db:deploy": "node ../../scripts/prisma-cli.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cloudinary": "2.7.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "pino-http": "10.5.0",
    "resend": "4.0.1",
    "stripe": "18.5.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "eslint": "9.35.0",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
